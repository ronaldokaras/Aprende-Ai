# ============================================================
# Aprende Aí — .gitignore
# ============================================================

# --- Segredos / configuração local ---
#config.js

# --- Sistema operacional ---
.DS_Store
.DS_Store?
Thumbs.db
Desktop.ini
ehthumbs.db

# --- Editores / IDEs ---
.idea/
.vscode/
*.swp
*.swo
*~
.project
.settings/

# --- Logs e temporários ---
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.cache/
tmp/
temp/
*.tmp

# --- Dependências (se usar npm no futuro) ---
node_modules/
package-lock.json
yarn.lock
pnpm-lock.yaml

# --- Build / dist ---
dist/
build/
.out/

# --- Ambiente ---
.env
.env.*
!.env.example

# --- Service Worker cache local (dev) ---
# (não costuma ir pro repo)

# --- Testes / cobertura ---
coverage/
.nyc_output/